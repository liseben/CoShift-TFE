# Modèle de configuration du backend CoShift.
# Copier ce fichier en `.env` (non versionné) et compléter les valeurs.
#
#   cp .env.example .env

# --- BASE DE DONNÉES (WAMP / MySQL) ---
# Compte MySQL local. Sous WAMP, root n'a pas de mot de passe par défaut.
DB_USERNAME=root
DB_PASSWORD=
# Optionnel : surcharge complète de l'URL JDBC (autre hôte, autre port, autre base).
# DB_URL=jdbc:mysql://localhost:3306/coshift_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# --- SERVEUR ---
# Port d'écoute du backend. À changer si le 8080 est déjà occupé sur le poste
# (console web PEM de PostgreSQL, Tomcat, etc.).
SERVER_PORT=8080

# --- JWT ---
# Clé de signature encodée en Base64, 256 bits minimum.
# Générer avec : openssl rand -base64 32
# Ne pas la changer en cours de route : tous les utilisateurs seraient déconnectés.
JWT_SECRET_KEY=
# Durée de validité du token en millisecondes (86400000 = 24 h).
JWT_EXPIRATION=86400000

# --- API D'ACTUALITÉS ---
# Clés gratuites : https://gnews.io  et  https://newsdata.io
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# --- EMAIL (Gmail SMTP) ---
# MAIL_APP_PASSWORD est un mot de passe d'application Gmail, pas le mot de passe
# du compte : https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# --- STRIPE (paiement — F28, pas encore implémenté) ---
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
