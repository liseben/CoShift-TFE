# Modèle de configuration du backend CoShift.
# Copier ce fichier en `.env` (non versionné) et compléter les valeurs.
#
#   cp .env.example .env

# --- BASE DE DONNÉES (WAMP / MySQL) ---
# Compte MySQL local. Sous WAMP, root n'a pas de mot de passe par défaut.
DB_USERNAME=root
DB_PASSWORD=
# Optionnel : surcharge complète de l'URL JDBC (autre hôte, autre port, autre base).
# DB_URL=jdbc:mysql://localhost:3306/coshift_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# --- SERVEUR ---
# Port d'écoute du backend. À changer si le 8080 est déjà occupé sur le poste
# (console web PEM de PostgreSQL, Tomcat, etc.).
SERVER_PORT=8080

# --- JWT ---
# Clé de signature encodée en Base64, 256 bits minimum.
#
# La valeur ci-dessous est une clé de DÉMONSTRATION, fournie pour que le projet
# démarre et se laisse essayer sans configuration préalable. Laissée vide, la
# clé ferait 0 bit : l'application démarrerait normalement puis renverrait une
# erreur 500 à la première connexion, ce qui est le pire des deux mondes.
#
# ELLE EST PUBLIQUE, DONC SANS VALEUR DE SECRET. Avant toute mise en ligne,
# la remplacer par une clé tirée au hasard :
#     openssl rand -base64 32
#     ou, sans openssl :  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#
# Ne pas la changer en cours de route : tous les utilisateurs seraient déconnectés.
JWT_SECRET_KEY=tsbhADfm3CnzS1502zdztNd+YxVsic9eZtPIozrhfeQ=
# Durée de validité du token en millisecondes (86400000 = 24 h).
JWT_EXPIRATION=86400000

# --- API D'ACTUALITÉS ---
# Clés gratuites : https://gnews.io  et  https://newsdata.io
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# --- EMAIL (Gmail SMTP) ---
# MAIL_APP_PASSWORD est un mot de passe d'application Gmail, pas le mot de passe
# du compte : https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# --- STRIPE (partage de frais — F28) ---
# Facultatif. Laissées vides, les paiements passent par une simulation et
# l'application démarre normalement : c'est ce qui permet de lancer le projet
# sans compte Stripe. Le journal du backend indique au démarrage quel
# prestataire a été retenu.
#
# Clés de TEST uniquement : https://dashboard.stripe.com/test/apikeys
# Une clé sk_live_ ferait circuler de l'argent réel.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret des notifications, obtenu avec :
#   stripe listen --forward-to localhost:8081/api/payments/webhook
# Sans lui, le point d'entrée des notifications refuse tout : on ne croit pas
# une notification qu'on ne peut pas vérifier.
STRIPE_WEBHOOK_SECRET=
