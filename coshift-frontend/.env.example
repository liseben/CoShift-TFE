# Modèle de configuration du frontend CoShift.
# Copier ce fichier en `.env` (non versionné) et compléter les valeurs.
#
#   cp .env.example .env
#
# Vite n'expose au navigateur que les variables préfixées VITE_.
# Ne jamais y placer de secret : elles finissent en clair dans le bundle.

# URL du backend Spring Boot. Doit correspondre à SERVER_PORT côté backend.
VITE_API_URL=http://localhost:8080

# Token public Mapbox pour la carte animée de la page d'accueil.
# https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Clé publique Stripe (pk_test_...) — paiement F28, pas encore implémenté.
VITE_STRIPE_PUBLIC_KEY=
